# ==============================================================================
# SMART READER - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# --- SYSTEM HOST PORTS --------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
ADMINER_PORT=8080

# --- RELATIONAL DATABASE (POSTGRESQL) -----------------------------------------
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_super_secure_db_password
POSTGRES_DB=smart_reader_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- S3-COMPATIBLE OBJECT STORAGE (MINIO) -------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=your_super_secure_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- AUTHENTICATION AND SECURITY (JWT TOKENS) ---------------------------------
# Generate a secure random key using: openssl rand -hex 32
JWT_SECRET_KEY=your_random_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI PROVIDERS INTEGRATION -------------------------------------------------
# Cloud Provider (Google Gemini API Key)
AI_API_KEY=your_gemini_api_key_here

# Local Provider (Ollama API)
OLLAMA_API_URL=http://10.17.17.144:11434/api/chat
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=60

# --- FRONTEND NETWORK ADDRESS (VITE) ------------------------------------------
VITE_API_URL=http://127.0.0.1:8000